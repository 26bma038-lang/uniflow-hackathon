import React, { useState } from "react";
import { Icon } from "@iconify/react";

// Reusable Category Badge Component
interface CategoryBadgeProps {
  icon: string;
  label: string;
}

function CategoryBadge({ icon, label }: CategoryBadgeProps) {
  return (
    <span className="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium flex items-center gap-2 shrink-0">
      <Icon className="text-primary text-lg" icon={icon} />
      {label}
    </span>
  );
}

// Reusable Step Card Component
interface StepCardProps {
  stepNumber: string;
  icon: string;
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
}

function StepCard({ stepNumber, icon, title, description, imageSrc, imageAlt }: StepCardProps) {
  return (
    <article className="rounded-[24px] bg-card p-7 shadow-theme flex flex-col justify-between">
      <div>
        <span className="font-mono text-sm text-primary">{stepNumber}</span>
        <div className="mt-8 flex size-12 items-center justify-center rounded-2xl bg-primary text-xl text-primary-foreground">
          <Icon icon={icon} />
        </div>
        <h3 className="mt-6 text-2xl font-semibold">{title}</h3>
        <p className="mt-3 leading-7 text-muted-foreground">{description}</p>
      </div>
      <img src={imageSrc} alt={imageAlt} className="mt-7 h-52 w-full object-contain" />
    </article>
  );
}

