# Copy to .env.local and fill in. Never commit real values.

# Browser (Vite exposes only VITE_ variables). Both values are public by design:
# row level security, not the key, decides what a signed-in user can do.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Server-side and admin scripts only. Never prefix these with VITE_ and never import them in src/.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
GEMINI_API_KEY=your-gemini-api-key

# Optional: dev server port (default 8443)
# PORT=8443
